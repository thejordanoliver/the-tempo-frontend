{
  "name": "the-tempo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:local": "node ./scripts/start-local.mjs",
    "start:hosted": "node ./scripts/start-hosted.mjs",
    "reset-project": "node ./scripts/reset-project.js",
    "test:play-by-play-field": "node --import tsx --test tests/footballRedZone.test.ts tests/basketballVisualizationRendering.test.mjs",
    "test:badges": "node ./scripts/test-badge-notification-store.js",
    "test:favorites": "node --import tsx --test tests/favoriteTeamKeys.test.ts tests/favoriteSportHeader.test.ts",
    "test:schedule": "node --experimental-strip-types --experimental-default-type=module --test tests/teamScheduleSelection.test.ts",
    "test:widget-grid": "node --import tsx --test tests/exploreWidgetGridLayout.test.ts",
    "test:widget-sync": "node --import tsx --test tests/exploreWidgetSync.test.ts tests/exploreWidgetAccountSwitch.test.mjs",
    "test:widget-storage": "node --import tsx --test tests/exploreWidgetStorage.test.ts",
    "test:favorite-games": "node --import tsx --test tests/exploreFavoriteGames.test.ts tests/exploreWidgetsApi.test.mjs tests/exploreWidgetLiveUpdates.test.mjs",
    "test:dm-privacy": "node --experimental-strip-types --experimental-default-type=module --test tests/dmPrivacyFrontend.test.ts",
    "test:auth-forms": "node --import tsx --test tests/authFormSchemas.test.ts",
    "test:profile-forms": "node --import tsx --test tests/editProfileSchema.test.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "node ./scripts/run-ios-device.mjs",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "test:navigation": "node --import tsx --test tests/tabStackRouteCoverage.test.ts",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "test": "node --import tsx --test --test-concurrency=4 tests/*.test.* && npm run test:badges",
    "typecheck": "tsc --noEmit",
    "export:all": "expo export --platform all --max-workers 2",
    "export:web": "expo export --platform web",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@sentry/react-native": "~8.33.0",
    "axios": "^1.21.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.18",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.19",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sms": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "expo-video-thumbnails": "~58.0.3",
    "expo-web-browser": "~58.0.8",
    "expo-widgets": "~58.0.28",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.87.0",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1313.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-video": "^6.17.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "reicon-react-native": "^1.0.102",
    "socket.io-client": "^4.8.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/date-fns": "^2.5.3",
    "@types/node": "^22.20.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "react-refresh": "^0.14.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": ["@sentry/react-native"]
    }
  },
  "overrides": {
    "glob@>=9 <14.0.2": "14.0.4",
    "minimatch@>=7 <11.0.1": "11.0.5"
  }
}
