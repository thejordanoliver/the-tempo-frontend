# Expo SDK 58 + React Native 0.88 migration.
# npm v10 otherwise auto-resolves a Windows-only peer of datetimepicker@9.2.1
# to react-native-windows@0.85, which requires React Native 0.85.
# Tempo targets iOS, Android, Web, not Windows. Keep npm ci deterministic.
# Revisit/remove after the date picker/Windows peer dependency is compatible.
legacy-peer-deps=true
