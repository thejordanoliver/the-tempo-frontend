{
  "expo": {
    "name": "the-tempo",
    "slug": "the-tempo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appIcon.png",
    "scheme": "tempo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jordanoliver.thetempo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Tempo connects to your Mac on the local network to load the app during development."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "icon": "./assets/images/appIcon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "package": "com.jordanoliver.thetempo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/tempo_light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash/tempo_dark.png",
            "backgroundColor": "#1d1d1d"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "react-native-video",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-secure-store",
      "./plugins/withDeviceWidgetEntitlements",
      [
        "expo-widgets",
        {
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "TempoFavoriteGames",
              "displayName": "Favorite Games",
              "description": "Scores and upcoming games for your favorite teams on Tempo.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "configuration": {
                  "title": "Favorite Games",
                  "description": "Show all favorite teams or choose a league.",
                  "parameters": {
                    "league": {
                      "title": "League",
                      "type": "enum",
                      "default": "all",
                      "values": [
                        {
                          "name": "All Leagues",
                          "value": "all"
                        },
                        {
                          "name": "NBA",
                          "value": "nba"
                        },
                        {
                          "name": "WNBA",
                          "value": "wnba"
                        },
                        {
                          "name": "Men’s College Basketball",
                          "value": "mcbb"
                        },
                        {
                          "name": "Women’s College Basketball",
                          "value": "wcbb"
                        },
                        {
                          "name": "MLB",
                          "value": "mlb"
                        },
                        {
                          "name": "College Baseball",
                          "value": "cb"
                        },
                        {
                          "name": "NFL",
                          "value": "nfl"
                        },
                        {
                          "name": "College Football",
                          "value": "cfb"
                        },
                        {
                          "name": "UFL",
                          "value": "ufl"
                        },
                        {
                          "name": "NHL",
                          "value": "nhl"
                        },
                        {
                          "name": "Men’s College Volleyball",
                          "value": "mcvb"
                        },
                        {
                          "name": "Women’s College Volleyball",
                          "value": "wcvb"
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "995a6f38-1d85-461d-a0c6-3f815440fbd2"
      }
    }
  }
}
